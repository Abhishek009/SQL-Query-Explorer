{
  "name": "trino-explorer",
  "displayName": "Trino Explorer",
  "publisher": "big-tech-talk",
  "description": "Connect to Trino and browse available catalogs.",
  "version": "1.0.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abhishek009/trino-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Abhishek009/trino-plugin/issues"
  },
  "homepage": "https://github.com/Abhishek009/trino-plugin#readme",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "trino",
    "sql",
    "database",
    "query",
    "presto"
  ],
  "activationEvents": [
    "onLanguage:sql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "trino.addConnection",
        "title": "Trino: Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "trino.editConnection",
        "title": "Trino: Edit Connection",
        "icon": "$(edit)"
      },
      {
        "command": "trino.removeConnection",
        "title": "Trino: Remove Connection",
        "icon": "$(trash)"
      },
      {
        "command": "trino.setActiveConnection",
        "title": "Trino: Use Connection for Queries",
        "icon": "$(check)"
      },
      {
        "command": "trino.connect",
        "title": "Trino: Connect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "trino.configureConnection",
        "title": "Trino: Configure Connection"
      },
      {
        "command": "trino.previewTable",
        "title": "Trino: Preview Table Data",
        "icon": "$(table)"
      },
      {
        "command": "trino.tableClicked",
        "title": "Trino: Open Table From Tree"
      },
      {
        "command": "trino.openQuery",
        "title": "Trino: New SQL Query",
        "icon": "$(new-file)"
      },
      {
        "command": "trino.runActiveSql",
        "title": "Trino: Run SQL Query",
        "icon": "$(play)"
      },
      {
        "command": "trino.refreshCatalogs",
        "title": "Trino: Refresh Catalogs",
        "icon": "$(refresh)"
      },
      {
        "command": "trino.cancelQuery",
        "title": "Trino: Cancel Running Query",
        "icon": "$(stop-circle)"
      },
      {
        "command": "trino.showTableDdl",
        "title": "Trino: Show Table DDL",
        "icon": "$(file-code)"
      },
      {
        "command": "trino.refreshNode",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "trino.newQueryHere",
        "title": "New Query Here",
        "icon": "$(new-file)"
      },
      {
        "command": "trino.runStatement",
        "title": "Trino: Run Statement",
        "icon": "$(play)"
      },
      {
        "command": "trino.runStatementNewTab",
        "title": "Trino: Run Statement in New Tab",
        "icon": "$(split-horizontal)"
      }
    ],
    "configuration": {
      "title": "Trino Explorer",
      "properties": {
        "trino.connections": {
          "type": "array",
          "default": [],
          "description": "Saved Trino connections. Managed by the Connections view — passwords are kept in Secret Storage, not here.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "url",
              "user"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier for the connection."
              },
              "name": {
                "type": "string",
                "description": "Display name shown in the Connections view."
              },
              "url": {
                "type": "string",
                "description": "Coordinator URL, for example https://trino.example.com:443."
              },
              "user": {
                "type": "string",
                "description": "User sent in the X-Trino-User header."
              },
              "catalog": {
                "type": "string",
                "description": "Optional default catalog for the session."
              },
              "schema": {
                "type": "string",
                "description": "Optional default schema for the session."
              },
              "maxRows": {
                "type": "number",
                "minimum": 1,
                "description": "Optional per-connection row cap. Overrides trino.query.maxRows."
              }
            }
          }
        },
        "trino.query.maxRows": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "maximum": 1000000,
          "markdownDescription": "Maximum rows fetched from Trino for any statement. The extension stops paging and cancels the query once this many rows have arrived, which bounds memory for queries without a `LIMIT`. A connection can override this in its own settings."
        },
        "trino.results.position": {
          "type": "string",
          "default": "below",
          "enum": [
            "below",
            "beside"
          ],
          "enumDescriptions": [
            "Stack the results under the query editor (horizontal split).",
            "Open the results in the column to the right (vertical split)."
          ],
          "description": "Where a results tab opens relative to the query editor."
        },
        "trino.preview.rowLimit": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 10000,
          "description": "Number of rows fetched when previewing a table from the Connections view."
        },
        "trino.connection.name": {
          "type": "string",
          "default": "Trino Connection",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        },
        "trino.connection.url": {
          "type": "string",
          "default": "http://localhost:8080",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        },
        "trino.connection.user": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        },
        "trino.connection.catalog": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        },
        "trino.connection.schema": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trino",
          "title": "Trino",
          "icon": "resources/trino.svg"
        }
      ]
    },
    "views": {
      "trino": [
        {
          "id": "trinoCatalogs",
          "name": "Connections",
          "icon": "resources/trino.svg",
          "contextualTitle": "Trino"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "trinoCatalogs",
        "contents": "No Trino connections yet.\n[Add Connection](command:trino.addConnection)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "trino.setActiveConnection",
          "when": "false"
        },
        {
          "command": "trino.previewTable",
          "when": "false"
        },
        {
          "command": "trino.tableClicked",
          "when": "false"
        },
        {
          "command": "trino.showTableDdl",
          "when": "false"
        },
        {
          "command": "trino.refreshNode",
          "when": "false"
        },
        {
          "command": "trino.newQueryHere",
          "when": "false"
        },
        {
          "command": "trino.runStatement",
          "when": "false"
        },
        {
          "command": "trino.runStatementNewTab",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "trino.addConnection",
          "when": "view == trinoCatalogs",
          "group": "navigation@1"
        },
        {
          "command": "trino.openQuery",
          "when": "view == trinoCatalogs",
          "group": "navigation@2"
        },
        {
          "command": "trino.refreshCatalogs",
          "when": "view == trinoCatalogs",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "trino.previewTable",
          "when": "view == trinoCatalogs && viewItem =~ /^trino\\.(table|view)$/",
          "group": "inline@1"
        },
        {
          "command": "trino.previewTable",
          "when": "view == trinoCatalogs && viewItem =~ /^trino\\.(table|view)$/",
          "group": "1_table@1"
        },
        {
          "command": "trino.showTableDdl",
          "when": "view == trinoCatalogs && viewItem =~ /^trino\\.(table|view)$/",
          "group": "1_table@2"
        },
        {
          "command": "trino.newQueryHere",
          "when": "view == trinoCatalogs && viewItem =~ /^trino\\.(catalog|schema|table|view)$/",
          "group": "inline@5"
        },
        {
          "command": "trino.newQueryHere",
          "when": "view == trinoCatalogs && viewItem =~ /^trino\\.(catalog|schema|table|view)$/",
          "group": "1_table@0"
        },
        {
          "command": "trino.refreshNode",
          "when": "view == trinoCatalogs && viewItem =~ /^trino\\.(catalog|schema|table|view|group)/",
          "group": "inline@9"
        },
        {
          "command": "trino.refreshNode",
          "when": "view == trinoCatalogs && viewItem =~ /^trino\\.(catalog|schema|table|view|group)/",
          "group": "9_refresh@1"
        },
        {
          "command": "trino.refreshCatalogs",
          "when": "view == trinoCatalogs && viewItem =~ /^trino\\.connection/",
          "group": "inline@1"
        },
        {
          "command": "trino.editConnection",
          "when": "view == trinoCatalogs && viewItem =~ /^trino\\.connection/",
          "group": "inline@2"
        },
        {
          "command": "trino.setActiveConnection",
          "when": "view == trinoCatalogs && viewItem == trino.connection",
          "group": "1_connection@1"
        },
        {
          "command": "trino.connect",
          "when": "view == trinoCatalogs && viewItem =~ /^trino\\.connection/",
          "group": "1_connection@2"
        },
        {
          "command": "trino.editConnection",
          "when": "view == trinoCatalogs && viewItem =~ /^trino\\.connection/",
          "group": "2_manage@1"
        },
        {
          "command": "trino.removeConnection",
          "when": "view == trinoCatalogs && viewItem =~ /^trino\\.connection/",
          "group": "2_manage@2"
        }
      ],
      "editor/title": [
        {
          "command": "trino.runActiveSql",
          "when": "resourceLangId == sql",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "trino.runActiveSql",
        "key": "cmd+enter",
        "mac": "cmd+enter",
        "linux": "ctrl+enter",
        "win": "ctrl+enter",
        "when": "editorTextFocus && resourceLangId == sql"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  }
}
