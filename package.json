{
  "name": "trino-explorer",
  "displayName": "SQL Query Explorer",
  "publisher": "big-tech-talk",
  "description": "Browse schemas and run queries from VS Code. Supports Trino, PostgreSQL, Supabase, SQLite, DuckDB, MySQL, MariaDB, MongoDB, and Snowflake.",
  "version": "2.6.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abhishek009/SQL-Query-Explorer.git"
  },
  "bugs": {
    "url": "https://github.com/Abhishek009/SQL-Query-Explorer/issues"
  },
  "homepage": "https://github.com/Abhishek009/SQL-Query-Explorer#readme",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "keywords": [
    "sql",
    "database",
    "query",
    "sql client",
    "trino",
    "presto",
    "postgres",
    "postgresql",
    "supabase",
    "sqlite",
    "duckdb",
    "mysql",
    "mariadb",
    "mongodb",
    "nosql",
    "snowflake"
  ],
  "activationEvents": [
    "onLanguage:sql"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sqlExplorer.addConnection",
        "title": "SQL: Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "sqlExplorer.editConnection",
        "title": "SQL: Edit Connection",
        "icon": "$(edit)"
      },
      {
        "command": "sqlExplorer.removeConnection",
        "title": "SQL: Remove Connection",
        "icon": "$(trash)"
      },
      {
        "command": "sqlExplorer.setActiveConnection",
        "title": "SQL: Use Connection for Queries",
        "icon": "$(check)"
      },
      {
        "command": "sqlExplorer.connect",
        "title": "SQL: Connect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "sqlExplorer.configureConnection",
        "title": "SQL: Configure Connection"
      },
      {
        "command": "sqlExplorer.previewTable",
        "title": "SQL: Preview Table Data",
        "icon": "$(table)"
      },
      {
        "command": "sqlExplorer.tableClicked",
        "title": "SQL: Open Table From Tree"
      },
      {
        "command": "sqlExplorer.openQuery",
        "title": "SQL: New SQL Query",
        "icon": "$(new-file)"
      },
      {
        "command": "sqlExplorer.runActiveSql",
        "title": "SQL: Run SQL Query",
        "icon": "$(play)"
      },
      {
        "command": "sqlExplorer.refreshCatalogs",
        "title": "SQL: Refresh Catalogs",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlExplorer.cancelQuery",
        "title": "SQL: Cancel Running Query",
        "icon": "$(stop-circle)"
      },
      {
        "command": "sqlExplorer.showTableDdl",
        "title": "SQL: Show Table DDL",
        "icon": "$(file-code)"
      },
      {
        "command": "sqlExplorer.importData",
        "title": "SQL: Import Data from CSV…",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "sqlExplorer.dropTable",
        "title": "SQL: Drop Table…",
        "icon": "$(trash)"
      },
      {
        "command": "sqlExplorer.refreshNode",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlExplorer.newQueryHere",
        "title": "New Query Here",
        "icon": "$(new-file)"
      },
      {
        "command": "sqlExplorer.runStatement",
        "title": "SQL: Run Statement",
        "icon": "$(play)"
      },
      {
        "command": "sqlExplorer.runStatementNewTab",
        "title": "SQL: Run Statement in New Tab",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "sqlExplorer.selectQueryConnection",
        "title": "SQL: Select Connection for This Query"
      },
      {
        "command": "sqlExplorer.selectQueryDatabase",
        "title": "SQL: Select Catalog or Database for This Query"
      },
      {
        "command": "sqlExplorer.saveCurrentQuery",
        "title": "SQL: Save Current Query…",
        "icon": "$(save)"
      },
      {
        "command": "sqlExplorer.formatQuery",
        "title": "SQL: Format Query"
      },
      {
        "command": "sqlExplorer.historyRunEntry",
        "title": "Run Query"
      },
      {
        "command": "sqlExplorer.historyOpenInEditor",
        "title": "Open in Editor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sqlExplorer.historyCopySql",
        "title": "Copy SQL",
        "icon": "$(copy)"
      },
      {
        "command": "sqlExplorer.historySaveAsFavorite",
        "title": "Save as Favorite…",
        "icon": "$(star-add)"
      },
      {
        "command": "sqlExplorer.historyRemoveEntry",
        "title": "Remove from History",
        "icon": "$(close)"
      },
      {
        "command": "sqlExplorer.historyClearConnection",
        "title": "Clear History for This Connection",
        "icon": "$(clear-all)"
      },
      {
        "command": "sqlExplorer.historyClearAll",
        "title": "SQL: Clear All Query History",
        "icon": "$(clear-all)"
      },
      {
        "command": "sqlExplorer.historySearch",
        "title": "SQL: Search Query History",
        "icon": "$(search)"
      },
      {
        "command": "sqlExplorer.historyClearSearch",
        "title": "Clear History Search",
        "icon": "$(search-stop)"
      },
      {
        "command": "sqlExplorer.savedQueryRun",
        "title": "Run Query"
      },
      {
        "command": "sqlExplorer.savedQueryOpenInEditor",
        "title": "Open in Editor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sqlExplorer.savedQueryInsertIntoEditor",
        "title": "Insert into Active Editor"
      },
      {
        "command": "sqlExplorer.savedQueryRename",
        "title": "Rename…"
      },
      {
        "command": "sqlExplorer.savedQueryMove",
        "title": "Move to Folder…"
      },
      {
        "command": "sqlExplorer.savedQueryDuplicate",
        "title": "Duplicate"
      },
      {
        "command": "sqlExplorer.savedQueryDelete",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "sqlExplorer.savedQueryNew",
        "title": "SQL: New Saved Query…",
        "icon": "$(add)"
      },
      {
        "command": "sqlExplorer.savedQueryNewFolder",
        "title": "SQL: New Saved Query Folder…",
        "icon": "$(new-folder)"
      },
      {
        "command": "sqlExplorer.savedQueryFolderRename",
        "title": "Rename Folder…"
      },
      {
        "command": "sqlExplorer.savedQueryFolderDelete",
        "title": "Delete Folder…",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "SQL Query Explorer",
      "properties": {
        "sqlExplorer.connections": {
          "type": "array",
          "default": [],
          "description": "Saved connections. Managed by the Connections view — passwords are kept in Secret Storage, not here.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "url",
              "user"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier for the connection."
              },
              "name": {
                "type": "string",
                "description": "Display name shown in the Connections view."
              },
              "url": {
                "type": "string",
                "description": "Server URL, for example https://trino.example.com:443 or postgresql://localhost:5432."
              },
              "user": {
                "type": "string",
                "description": "User name sent when connecting."
              },
              "catalog": {
                "type": "string",
                "description": "Trino: optional default catalog. PostgreSQL: the database to open."
              },
              "schema": {
                "type": "string",
                "description": "Optional default schema for the session."
              },
              "maxRows": {
                "type": "number",
                "minimum": 1,
                "description": "Optional per-connection row cap. Overrides sqlExplorer.query.maxRows."
              },
              "type": {
                "type": "string",
                "enum": [
                  "trino",
                  "postgres",
                  "supabase",
                  "sqlite",
                  "duckdb",
                  "mysql",
                  "mongodb",
                  "mariadb",
                  "snowflake"
                ],
                "description": "Engine this connection speaks. Absent means Trino."
              },
              "warehouse": {
                "type": "string",
                "description": "Snowflake only: the default virtual warehouse for the session."
              },
              "role": {
                "type": "string",
                "description": "Snowflake only: the default security role for the session."
              },
              "authenticator": {
                "type": "string",
                "enum": [
                  "password",
                  "externalbrowser"
                ],
                "description": "Snowflake only: how to authenticate. Absent/'password' means username+password; 'externalbrowser' opens the system browser for SSO and stores no password."
              },
              "ssl": {
                "type": "boolean",
                "description": "PostgreSQL/Supabase/MySQL/MongoDB/MariaDB only: use TLS to reach the server."
              },
              "sslVerify": {
                "type": "boolean",
                "default": true,
                "description": "Trino only: verify the server's TLS certificate. Turning this off trusts any certificate the server presents — only for a server with a known certificate mismatch."
              }
            }
          }
        },
        "trino.connections": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "url",
              "user"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier for the connection."
              },
              "name": {
                "type": "string",
                "description": "Display name shown in the Connections view."
              },
              "url": {
                "type": "string",
                "description": "Coordinator URL, for example https://trino.example.com:443."
              },
              "user": {
                "type": "string",
                "description": "User sent in the X-Trino-User header."
              },
              "catalog": {
                "type": "string",
                "description": "Optional default catalog for the session."
              },
              "schema": {
                "type": "string",
                "description": "Optional default schema for the session."
              },
              "maxRows": {
                "type": "number",
                "minimum": 1,
                "description": "Optional per-connection row cap. Overrides trino.query.maxRows."
              }
            }
          },
          "markdownDeprecationMessage": "Superseded by `#sqlExplorer.connections#`. Existing values are migrated automatically."
        },
        "sqlExplorer.query.maxRows": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "maximum": 1000000,
          "markdownDescription": "Maximum rows fetched for any statement. The extension stops paging and cancels the query once this many rows have arrived, which bounds memory for queries without a `LIMIT`. A connection can override this in its own settings."
        },
        "trino.query.maxRows": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "maximum": 1000000,
          "markdownDeprecationMessage": "Superseded by `#sqlExplorer.query.maxRows#`. Existing values are migrated automatically."
        },
        "sqlExplorer.preview.rowLimit": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 10000,
          "description": "Number of rows fetched when previewing a table from the Connections view."
        },
        "trino.preview.rowLimit": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 10000,
          "markdownDeprecationMessage": "Superseded by `#sqlExplorer.preview.rowLimit#`. Existing values are migrated automatically."
        },
        "sqlExplorer.history.limit": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "maximum": 10000,
          "description": "Maximum number of past queries kept per connection in the History view. Oldest entries drop off past this."
        },
        "sqlExplorer.savedQueries": {
          "type": "array",
          "default": [],
          "description": "Named queries shown in the Saved Queries view. Managed by that view — hand-editing is supported but not required.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "sql",
              "createdAt",
              "updatedAt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier for the saved query."
              },
              "name": {
                "type": "string",
                "description": "Display name shown in the Saved Queries view."
              },
              "sql": {
                "type": "string",
                "description": "The query text."
              },
              "folder": {
                "type": "string",
                "description": "Slash-separated folder path, e.g. \"Reports/Weekly\". Absent means the root."
              },
              "connectionId": {
                "type": "string",
                "description": "The connection this was written for. Falls back to the active connection if it no longer exists."
              },
              "database": {
                "type": "string",
                "description": "The catalog/database it ran against, for engines that address one."
              },
              "createdAt": {
                "type": "number",
                "description": "When this was first saved, in epoch milliseconds."
              },
              "updatedAt": {
                "type": "number",
                "description": "When this was last saved, in epoch milliseconds."
              }
            }
          }
        },
        "sqlExplorer.savedQueryFolders": {
          "type": "array",
          "default": [],
          "description": "Folders in the Saved Queries view that have no query directly or transitively in them yet. Managed by that view.",
          "items": {
            "type": "string"
          }
        },
        "sqlExplorer.format.keywordCase": {
          "type": "string",
          "enum": ["upper", "lower", "preserve"],
          "enumDescriptions": [
            "SELECT, FROM, WHERE, …",
            "select, from, where, …",
            "Leave keyword casing exactly as typed"
          ],
          "default": "upper",
          "description": "How SQL: Format Query and format-on-save case keywords. Indentation follows the editor's own tab size/spaces setting."
        },
        "trino.connection.name": {
          "type": "string",
          "default": "Trino Connection",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        },
        "trino.connection.url": {
          "type": "string",
          "default": "http://localhost:8080",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        },
        "trino.connection.user": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        },
        "trino.connection.catalog": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        },
        "trino.connection.schema": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sqlExplorer",
          "title": "SQL Query Explorer",
          "icon": "resources/trino.svg"
        }
      ]
    },
    "views": {
      "sqlExplorer": [
        {
          "id": "sqlExplorerConnections",
          "name": "Connections",
          "icon": "resources/trino.svg",
          "contextualTitle": "SQL Query Explorer"
        },
        {
          "id": "sqlExplorerSavedQueries",
          "name": "Saved Queries",
          "icon": "resources/trino.svg",
          "contextualTitle": "SQL Query Explorer"
        },
        {
          "id": "sqlExplorerHistory",
          "name": "History",
          "icon": "resources/trino.svg",
          "contextualTitle": "SQL Query Explorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sqlExplorerConnections",
        "contents": "No connections yet.\n[Add Connection](command:sqlExplorer.addConnection)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sqlExplorer.setActiveConnection",
          "when": "false"
        },
        {
          "command": "sqlExplorer.previewTable",
          "when": "false"
        },
        {
          "command": "sqlExplorer.tableClicked",
          "when": "false"
        },
        {
          "command": "sqlExplorer.showTableDdl",
          "when": "false"
        },
        {
          "command": "sqlExplorer.importData",
          "when": "false"
        },
        {
          "command": "sqlExplorer.refreshNode",
          "when": "false"
        },
        {
          "command": "sqlExplorer.newQueryHere",
          "when": "false"
        },
        {
          "command": "sqlExplorer.runStatement",
          "when": "false"
        },
        {
          "command": "sqlExplorer.runStatementNewTab",
          "when": "false"
        },
        {
          "command": "sqlExplorer.selectQueryConnection",
          "when": "editorLangId == sql"
        },
        {
          "command": "sqlExplorer.selectQueryDatabase",
          "when": "editorLangId == sql"
        },
        {
          "command": "sqlExplorer.saveCurrentQuery",
          "when": "editorLangId == sql"
        },
        {
          "command": "sqlExplorer.formatQuery",
          "when": "editorLangId == sql"
        },
        {
          "command": "sqlExplorer.historyRunEntry",
          "when": "false"
        },
        {
          "command": "sqlExplorer.historyOpenInEditor",
          "when": "false"
        },
        {
          "command": "sqlExplorer.historyCopySql",
          "when": "false"
        },
        {
          "command": "sqlExplorer.historySaveAsFavorite",
          "when": "false"
        },
        {
          "command": "sqlExplorer.historyRemoveEntry",
          "when": "false"
        },
        {
          "command": "sqlExplorer.historyClearConnection",
          "when": "false"
        },
        {
          "command": "sqlExplorer.savedQueryRun",
          "when": "false"
        },
        {
          "command": "sqlExplorer.savedQueryOpenInEditor",
          "when": "false"
        },
        {
          "command": "sqlExplorer.savedQueryInsertIntoEditor",
          "when": "false"
        },
        {
          "command": "sqlExplorer.savedQueryRename",
          "when": "false"
        },
        {
          "command": "sqlExplorer.savedQueryMove",
          "when": "false"
        },
        {
          "command": "sqlExplorer.savedQueryDuplicate",
          "when": "false"
        },
        {
          "command": "sqlExplorer.savedQueryDelete",
          "when": "false"
        },
        {
          "command": "sqlExplorer.savedQueryFolderRename",
          "when": "false"
        },
        {
          "command": "sqlExplorer.savedQueryFolderDelete",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sqlExplorer.addConnection",
          "when": "view == sqlExplorerConnections",
          "group": "navigation@1"
        },
        {
          "command": "sqlExplorer.openQuery",
          "when": "view == sqlExplorerConnections",
          "group": "navigation@2"
        },
        {
          "command": "sqlExplorer.refreshCatalogs",
          "when": "view == sqlExplorerConnections",
          "group": "navigation@3"
        },
        {
          "command": "sqlExplorer.savedQueryNew",
          "when": "view == sqlExplorerSavedQueries",
          "group": "navigation@1"
        },
        {
          "command": "sqlExplorer.savedQueryNewFolder",
          "when": "view == sqlExplorerSavedQueries",
          "group": "navigation@2"
        },
        {
          "command": "sqlExplorer.historySearch",
          "when": "view == sqlExplorerHistory && !sqlExplorer.historyFiltered",
          "group": "navigation@1"
        },
        {
          "command": "sqlExplorer.historyClearSearch",
          "when": "view == sqlExplorerHistory && sqlExplorer.historyFiltered",
          "group": "navigation@1"
        },
        {
          "command": "sqlExplorer.historyClearAll",
          "when": "view == sqlExplorerHistory",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sqlExplorer.previewTable",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.(table|view)$/",
          "group": "inline@1"
        },
        {
          "command": "sqlExplorer.previewTable",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.(table|view)$/",
          "group": "1_table@1"
        },
        {
          "command": "sqlExplorer.showTableDdl",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.(table|view)$/",
          "group": "1_table@2"
        },
        {
          "command": "sqlExplorer.importData",
          "when": "view == sqlExplorerConnections && viewItem == sqlExplorer.table",
          "group": "1_table@3"
        },
        {
          "command": "sqlExplorer.dropTable",
          "when": "view == sqlExplorerConnections && viewItem == sqlExplorer.table",
          "group": "8_destructive@1"
        },
        {
          "command": "sqlExplorer.newQueryHere",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.(catalog|schema|table|view)$/",
          "group": "inline@5"
        },
        {
          "command": "sqlExplorer.newQueryHere",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.(catalog|schema|table|view)$/",
          "group": "1_table@0"
        },
        {
          "command": "sqlExplorer.refreshNode",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.(catalog|schema|table|view|group)/",
          "group": "inline@9"
        },
        {
          "command": "sqlExplorer.refreshNode",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.(catalog|schema|table|view|group)/",
          "group": "9_refresh@1"
        },
        {
          "command": "sqlExplorer.refreshCatalogs",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.connection/",
          "group": "inline@1"
        },
        {
          "command": "sqlExplorer.editConnection",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.connection/",
          "group": "inline@2"
        },
        {
          "command": "sqlExplorer.setActiveConnection",
          "when": "view == sqlExplorerConnections && viewItem == sqlExplorer.connection",
          "group": "1_connection@1"
        },
        {
          "command": "sqlExplorer.connect",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.connection/",
          "group": "1_connection@2"
        },
        {
          "command": "sqlExplorer.editConnection",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.connection/",
          "group": "2_manage@1"
        },
        {
          "command": "sqlExplorer.removeConnection",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.connection/",
          "group": "2_manage@2"
        },
        {
          "command": "sqlExplorer.historyOpenInEditor",
          "when": "view == sqlExplorerHistory && viewItem == sqlExplorer.history.entry",
          "group": "inline@1"
        },
        {
          "command": "sqlExplorer.historyRunEntry",
          "when": "view == sqlExplorerHistory && viewItem == sqlExplorer.history.entry",
          "group": "1_run@1"
        },
        {
          "command": "sqlExplorer.historyOpenInEditor",
          "when": "view == sqlExplorerHistory && viewItem == sqlExplorer.history.entry",
          "group": "1_run@2"
        },
        {
          "command": "sqlExplorer.historyCopySql",
          "when": "view == sqlExplorerHistory && viewItem == sqlExplorer.history.entry",
          "group": "1_run@3"
        },
        {
          "command": "sqlExplorer.historySaveAsFavorite",
          "when": "view == sqlExplorerHistory && viewItem == sqlExplorer.history.entry",
          "group": "2_save@1"
        },
        {
          "command": "sqlExplorer.historyRemoveEntry",
          "when": "view == sqlExplorerHistory && viewItem == sqlExplorer.history.entry",
          "group": "8_destructive@1"
        },
        {
          "command": "sqlExplorer.historyClearConnection",
          "when": "view == sqlExplorerHistory && viewItem == sqlExplorer.history.group",
          "group": "8_destructive@1"
        },
        {
          "command": "sqlExplorer.savedQueryRun",
          "when": "view == sqlExplorerSavedQueries && viewItem == sqlExplorer.savedQuery.query",
          "group": "inline@1"
        },
        {
          "command": "sqlExplorer.savedQueryRun",
          "when": "view == sqlExplorerSavedQueries && viewItem == sqlExplorer.savedQuery.query",
          "group": "1_run@1"
        },
        {
          "command": "sqlExplorer.savedQueryOpenInEditor",
          "when": "view == sqlExplorerSavedQueries && viewItem == sqlExplorer.savedQuery.query",
          "group": "1_run@2"
        },
        {
          "command": "sqlExplorer.savedQueryInsertIntoEditor",
          "when": "view == sqlExplorerSavedQueries && viewItem == sqlExplorer.savedQuery.query",
          "group": "1_run@3"
        },
        {
          "command": "sqlExplorer.savedQueryRename",
          "when": "view == sqlExplorerSavedQueries && viewItem == sqlExplorer.savedQuery.query",
          "group": "2_manage@1"
        },
        {
          "command": "sqlExplorer.savedQueryMove",
          "when": "view == sqlExplorerSavedQueries && viewItem == sqlExplorer.savedQuery.query",
          "group": "2_manage@2"
        },
        {
          "command": "sqlExplorer.savedQueryDuplicate",
          "when": "view == sqlExplorerSavedQueries && viewItem == sqlExplorer.savedQuery.query",
          "group": "2_manage@3"
        },
        {
          "command": "sqlExplorer.savedQueryDelete",
          "when": "view == sqlExplorerSavedQueries && viewItem == sqlExplorer.savedQuery.query",
          "group": "8_destructive@1"
        },
        {
          "command": "sqlExplorer.savedQueryNew",
          "when": "view == sqlExplorerSavedQueries && viewItem == sqlExplorer.savedQuery.folder",
          "group": "inline@1"
        },
        {
          "command": "sqlExplorer.savedQueryNew",
          "when": "view == sqlExplorerSavedQueries && viewItem == sqlExplorer.savedQuery.folder",
          "group": "1_run@1"
        },
        {
          "command": "sqlExplorer.savedQueryNewFolder",
          "when": "view == sqlExplorerSavedQueries && viewItem == sqlExplorer.savedQuery.folder",
          "group": "1_run@2"
        },
        {
          "command": "sqlExplorer.savedQueryFolderRename",
          "when": "view == sqlExplorerSavedQueries && viewItem == sqlExplorer.savedQuery.folder",
          "group": "2_manage@1"
        },
        {
          "command": "sqlExplorer.savedQueryFolderDelete",
          "when": "view == sqlExplorerSavedQueries && viewItem == sqlExplorer.savedQuery.folder",
          "group": "8_destructive@1"
        }
      ],
      "editor/title": [
        {
          "command": "sqlExplorer.runActiveSql",
          "when": "resourceLangId == sql",
          "group": "navigation"
        },
        {
          "command": "sqlExplorer.saveCurrentQuery",
          "when": "resourceLangId == sql",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sqlExplorer.runActiveSql",
        "key": "cmd+enter",
        "mac": "cmd+enter",
        "linux": "ctrl+enter",
        "win": "ctrl+enter",
        "when": "editorTextFocus && resourceLangId == sql"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle -- --production",
    "bundle": "node esbuild.mjs",
    "compile": "tsc -p ./",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "install-local": "bash scripts/install-local.sh"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.4",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "mongodb": "^7.5.0",
    "mysql2": "^3.23.3",
    "pg": "^8.22.0",
    "sql-formatter": "^15.8.2",
    "undici": "^8.10.0"
  }
