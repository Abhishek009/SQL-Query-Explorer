{
  "name": "trino-explorer",
  "displayName": "SQL Query Explorer",
  "publisher": "big-tech-talk",
  "description": "Browse schemas and run SQL from VS Code. Supports Trino, PostgreSQL, Supabase, SQLite, DuckDB, and MySQL.",
  "version": "2.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abhishek009/sql-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/Abhishek009/sql-explorer/issues"
  },
  "homepage": "https://github.com/Abhishek009/sql-explorer#readme",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "keywords": [
    "sql",
    "database",
    "query",
    "sql client",
    "trino",
    "presto",
    "postgres",
    "postgresql",
    "supabase",
    "sqlite",
    "duckdb",
    "mysql"
  ],
  "activationEvents": [
    "onLanguage:sql"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sqlExplorer.addConnection",
        "title": "SQL: Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "sqlExplorer.editConnection",
        "title": "SQL: Edit Connection",
        "icon": "$(edit)"
      },
      {
        "command": "sqlExplorer.removeConnection",
        "title": "SQL: Remove Connection",
        "icon": "$(trash)"
      },
      {
        "command": "sqlExplorer.setActiveConnection",
        "title": "SQL: Use Connection for Queries",
        "icon": "$(check)"
      },
      {
        "command": "sqlExplorer.connect",
        "title": "SQL: Connect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "sqlExplorer.configureConnection",
        "title": "SQL: Configure Connection"
      },
      {
        "command": "sqlExplorer.previewTable",
        "title": "SQL: Preview Table Data",
        "icon": "$(table)"
      },
      {
        "command": "sqlExplorer.tableClicked",
        "title": "SQL: Open Table From Tree"
      },
      {
        "command": "sqlExplorer.openQuery",
        "title": "SQL: New SQL Query",
        "icon": "$(new-file)"
      },
      {
        "command": "sqlExplorer.runActiveSql",
        "title": "SQL: Run SQL Query",
        "icon": "$(play)"
      },
      {
        "command": "sqlExplorer.refreshCatalogs",
        "title": "SQL: Refresh Catalogs",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlExplorer.cancelQuery",
        "title": "SQL: Cancel Running Query",
        "icon": "$(stop-circle)"
      },
      {
        "command": "sqlExplorer.showTableDdl",
        "title": "SQL: Show Table DDL",
        "icon": "$(file-code)"
      },
      {
        "command": "sqlExplorer.importData",
        "title": "SQL: Import Data from CSV…",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "sqlExplorer.refreshNode",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlExplorer.newQueryHere",
        "title": "New Query Here",
        "icon": "$(new-file)"
      },
      {
        "command": "sqlExplorer.runStatement",
        "title": "SQL: Run Statement",
        "icon": "$(play)"
      },
      {
        "command": "sqlExplorer.runStatementNewTab",
        "title": "SQL: Run Statement in New Tab",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "sqlExplorer.selectQueryConnection",
        "title": "SQL: Select Connection for This Query"
      },
      {
        "command": "sqlExplorer.selectQueryDatabase",
        "title": "SQL: Select Catalog or Database for This Query"
      }
    ],
    "configuration": {
      "title": "SQL Query Explorer",
      "properties": {
        "sqlExplorer.connections": {
          "type": "array",
          "default": [],
          "description": "Saved connections. Managed by the Connections view — passwords are kept in Secret Storage, not here.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "url",
              "user"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier for the connection."
              },
              "name": {
                "type": "string",
                "description": "Display name shown in the Connections view."
              },
              "url": {
                "type": "string",
                "description": "Server URL, for example https://trino.example.com:443 or postgresql://localhost:5432."
              },
              "user": {
                "type": "string",
                "description": "User name sent when connecting."
              },
              "catalog": {
                "type": "string",
                "description": "Trino: optional default catalog. PostgreSQL: the database to open."
              },
              "schema": {
                "type": "string",
                "description": "Optional default schema for the session."
              },
              "maxRows": {
                "type": "number",
                "minimum": 1,
                "description": "Optional per-connection row cap. Overrides sqlExplorer.query.maxRows."
              },
              "type": {
                "type": "string",
                "enum": [
                  "trino",
                  "postgres",
                  "supabase",
                  "sqlite",
                  "duckdb",
                  "mysql"
                ],
                "description": "Engine this connection speaks. Absent means Trino."
              },
              "ssl": {
                "type": "boolean",
                "description": "PostgreSQL/Supabase only: use TLS to reach the server."
              },
              "sslVerify": {
                "type": "boolean",
                "default": true,
                "description": "Trino only: verify the server's TLS certificate. Turning this off trusts any certificate the server presents — only for a server with a known certificate mismatch."
              }
            }
          }
        },
        "trino.connections": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "url",
              "user"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier for the connection."
              },
              "name": {
                "type": "string",
                "description": "Display name shown in the Connections view."
              },
              "url": {
                "type": "string",
                "description": "Coordinator URL, for example https://trino.example.com:443."
              },
              "user": {
                "type": "string",
                "description": "User sent in the X-Trino-User header."
              },
              "catalog": {
                "type": "string",
                "description": "Optional default catalog for the session."
              },
              "schema": {
                "type": "string",
                "description": "Optional default schema for the session."
              },
              "maxRows": {
                "type": "number",
                "minimum": 1,
                "description": "Optional per-connection row cap. Overrides trino.query.maxRows."
              }
            }
          },
          "markdownDeprecationMessage": "Superseded by `#sqlExplorer.connections#`. Existing values are migrated automatically."
        },
        "sqlExplorer.query.maxRows": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "maximum": 1000000,
          "markdownDescription": "Maximum rows fetched for any statement. The extension stops paging and cancels the query once this many rows have arrived, which bounds memory for queries without a `LIMIT`. A connection can override this in its own settings."
        },
        "trino.query.maxRows": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "maximum": 1000000,
          "markdownDeprecationMessage": "Superseded by `#sqlExplorer.query.maxRows#`. Existing values are migrated automatically."
        },
        "sqlExplorer.preview.rowLimit": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 10000,
          "description": "Number of rows fetched when previewing a table from the Connections view."
        },
        "trino.preview.rowLimit": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 10000,
          "markdownDeprecationMessage": "Superseded by `#sqlExplorer.preview.rowLimit#`. Existing values are migrated automatically."
        },
        "trino.connection.name": {
          "type": "string",
          "default": "Trino Connection",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        },
        "trino.connection.url": {
          "type": "string",
          "default": "http://localhost:8080",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        },
        "trino.connection.user": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        },
        "trino.connection.catalog": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        },
        "trino.connection.schema": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Superseded by `#trino.connections#`. Existing values are migrated automatically."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sqlExplorer",
          "title": "SQL Query Explorer",
          "icon": "resources/trino.svg"
        }
      ]
    },
    "views": {
      "sqlExplorer": [
        {
          "id": "sqlExplorerConnections",
          "name": "Connections",
          "icon": "resources/trino.svg",
          "contextualTitle": "SQL Query Explorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sqlExplorerConnections",
        "contents": "No connections yet.\n[Add Connection](command:sqlExplorer.addConnection)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sqlExplorer.setActiveConnection",
          "when": "false"
        },
        {
          "command": "sqlExplorer.previewTable",
          "when": "false"
        },
        {
          "command": "sqlExplorer.tableClicked",
          "when": "false"
        },
        {
          "command": "sqlExplorer.showTableDdl",
          "when": "false"
        },
        {
          "command": "sqlExplorer.importData",
          "when": "false"
        },
        {
          "command": "sqlExplorer.refreshNode",
          "when": "false"
        },
        {
          "command": "sqlExplorer.newQueryHere",
          "when": "false"
        },
        {
          "command": "sqlExplorer.runStatement",
          "when": "false"
        },
        {
          "command": "sqlExplorer.runStatementNewTab",
          "when": "false"
        },
        {
          "command": "sqlExplorer.selectQueryConnection",
          "when": "editorLangId == sql"
        },
        {
          "command": "sqlExplorer.selectQueryDatabase",
          "when": "editorLangId == sql"
        }
      ],
      "view/title": [
        {
          "command": "sqlExplorer.addConnection",
          "when": "view == sqlExplorerConnections",
          "group": "navigation@1"
        },
        {
          "command": "sqlExplorer.openQuery",
          "when": "view == sqlExplorerConnections",
          "group": "navigation@2"
        },
        {
          "command": "sqlExplorer.refreshCatalogs",
          "when": "view == sqlExplorerConnections",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "sqlExplorer.previewTable",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.(table|view)$/",
          "group": "inline@1"
        },
        {
          "command": "sqlExplorer.previewTable",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.(table|view)$/",
          "group": "1_table@1"
        },
        {
          "command": "sqlExplorer.showTableDdl",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.(table|view)$/",
          "group": "1_table@2"
        },
        {
          "command": "sqlExplorer.importData",
          "when": "view == sqlExplorerConnections && viewItem == sqlExplorer.table",
          "group": "1_table@3"
        },
        {
          "command": "sqlExplorer.newQueryHere",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.(catalog|schema|table|view)$/",
          "group": "inline@5"
        },
        {
          "command": "sqlExplorer.newQueryHere",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.(catalog|schema|table|view)$/",
          "group": "1_table@0"
        },
        {
          "command": "sqlExplorer.refreshNode",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.(catalog|schema|table|view|group)/",
          "group": "inline@9"
        },
        {
          "command": "sqlExplorer.refreshNode",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.(catalog|schema|table|view|group)/",
          "group": "9_refresh@1"
        },
        {
          "command": "sqlExplorer.refreshCatalogs",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.connection/",
          "group": "inline@1"
        },
        {
          "command": "sqlExplorer.editConnection",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.connection/",
          "group": "inline@2"
        },
        {
          "command": "sqlExplorer.setActiveConnection",
          "when": "view == sqlExplorerConnections && viewItem == sqlExplorer.connection",
          "group": "1_connection@1"
        },
        {
          "command": "sqlExplorer.connect",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.connection/",
          "group": "1_connection@2"
        },
        {
          "command": "sqlExplorer.editConnection",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.connection/",
          "group": "2_manage@1"
        },
        {
          "command": "sqlExplorer.removeConnection",
          "when": "view == sqlExplorerConnections && viewItem =~ /^sqlExplorer\\.connection/",
          "group": "2_manage@2"
        }
      ],
      "editor/title": [
        {
          "command": "sqlExplorer.runActiveSql",
          "when": "resourceLangId == sql",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sqlExplorer.runActiveSql",
        "key": "cmd+enter",
        "mac": "cmd+enter",
        "linux": "ctrl+enter",
        "win": "ctrl+enter",
        "when": "editorTextFocus && resourceLangId == sql"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle -- --production",
    "bundle": "node esbuild.mjs",
    "compile": "tsc -p ./",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.4",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "mysql2": "^3.23.3",
    "pg": "^8.22.0",
    "undici": "^8.10.0"
  }
}
