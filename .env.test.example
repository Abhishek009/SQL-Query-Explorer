# Copy to .env.test (gitignored) and fill in a Trino coordinator and
# Postgres/MySQL servers reachable from this machine. Integration tests skip
# themselves when a block's variables are unset, so partial setups are fine.

TEST_TRINO_HOST=192.168.0.114
TEST_TRINO_PORT=8080
TEST_TRINO_USER=test
# TEST_TRINO_CATALOG/SCHEMA point at data the tests can read; tpch.sf1 ships
# with every Trino install via the tpch connector.
TEST_TRINO_CATALOG=tpch
TEST_TRINO_SCHEMA=sf1

TEST_PG_HOST=192.168.0.114
TEST_PG_PORT=5433
TEST_PG_USER=postgres
TEST_PG_PASSWORD=
# A database with at least one non-empty table the tests can read.
TEST_PG_DATABASE=dvdrental

TEST_MYSQL_HOST=192.168.0.114
TEST_MYSQL_PORT=3306
TEST_MYSQL_USER=root
TEST_MYSQL_PASSWORD=mysecretpassword