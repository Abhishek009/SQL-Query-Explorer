# Dev-only editor config
.vscode/**
.vscode-test/**

# TypeScript sources — only the bundle in dist/ is executed.
# Its source map is kept so user-reported stack traces stay readable.
src/**
**/*.ts
**/*.mts
out/**
esbuild.mjs

# Test suite and its config — never shipped, and .env.test carries real
# credentials for whichever server it was last pointed at, so this is not
# just tidiness. .vscodeignore is independent of .gitignore; nothing there
# keeps a file out of the package.
test/**
.env
.env.*
# Opt-in local caches for the SQLite/DuckDB integration tests — never
# installed for a real user, only present if a contributor deliberately
# fetched one to test against a real engine (see test/engines/*.test.ts).
.sqlite-test-cache/**
.duckdb-test-cache/**

# pg is bundled into dist/extension.js by esbuild, so it needs nothing here.
# SQLite and DuckDB are native modules downloaded on demand at runtime
# instead — see sqliteRuntime.ts/duckdbRuntime.ts — so nothing about them
# ships in the package at all.
node_modules/**

# Build and repo config
tsconfig.json
package-lock.json
.gitignore
.gitattributes

# Don't nest a package inside a package
*.vsix
