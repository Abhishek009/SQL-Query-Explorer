# Dev-only editor config
.vscode/**
.vscode-test/**

# TypeScript sources — only the bundle in dist/ is executed.
# Its source map is kept so user-reported stack traces stay readable.
src/**
**/*.ts
**/*.mts
out/**
esbuild.mjs

# Test suite and its config — never shipped, and .env.test carries real
# credentials for whichever server it was last pointed at, so this is not
# just tidiness. .vscodeignore is independent of .gitignore; nothing there
# keeps a file out of the package.
test/**
.env
.env.*
scripts/**
# The DuckDB integration tests' opt-in local cache — never installed for a
# real user, only present if a contributor deliberately fetched it to test
# against a real engine (see test/engines/duckdbClient.test.ts).
.duckdb-test-cache/**

# pg is bundled into dist/extension.js by esbuild, so it needs nothing here.
# better-sqlite3 is a native addon (a compiled .node binary) that esbuild
# cannot bundle, so its whole package directory ships as-is instead — vsce
# does not reliably support re-excluding paths nested under a negated
# directory, so this also carries its build-only source/headers (~10MB) that
# nothing at runtime touches. Trimming that requires deleting those files from
# node_modules before packaging, not a smarter ignore pattern.
node_modules/**
!node_modules/better-sqlite3/**

# Build and repo config
tsconfig.json
package-lock.json
.gitignore
.gitattributes

# Don't nest a package inside a package
*.vsix
