# Dev-only editor/tooling config
.vscode/**
.vscode-test/**
docker-compose*.yml

# Driver log files a live-tested engine (e.g. snowflake-sdk) can write to the
# repo root during manual testing — never intentional output, never shipped.
*.log

# TypeScript sources — only the bundle in dist/ is executed.
# Its source map is kept so user-reported stack traces stay readable.
src/**
**/*.ts
**/*.mts
out/**
esbuild.mjs

# Test suite and its config — never shipped, and .env.test carries real
# credentials for whichever server it was last pointed at, so this is not
# just tidiness. .vscodeignore is independent of .gitignore; nothing there
# keeps a file out of the package.
test/**
.env
.env.*
# Opt-in local caches for the SQLite/DuckDB/Snowflake integration tests — never
# installed for a real user, only present if a contributor deliberately
# fetched one to test against a real engine (see test/engines/*.test.ts).
.sqlite-test-cache/**
.duckdb-test-cache/**
.snowflake-test-cache/**

# pg/mysql2/mongodb are bundled into dist/extension.js by esbuild, so they
# need nothing here. SQLite, DuckDB, and Snowflake are downloaded on demand at
# runtime instead — see sqliteRuntime.ts/duckdbRuntime.ts/snowflakeRuntime.ts
# — so nothing about them ships in the package at all. Snowflake specifically
# because its official driver pulls in AWS/Azure/GCS SDKs for bulk-load
# features this extension never uses, which would triple the package size.
node_modules/**

# Build and repo config
tsconfig.json
package-lock.json
.gitignore
.gitattributes

# Don't nest a package inside a package
*.vsix
