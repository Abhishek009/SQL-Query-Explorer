# Dev-only editor config
.vscode/**
.vscode-test/**

# TypeScript sources — only the compiled out/ is executed.
# Source maps in out/ are kept intentionally so user-reported
# stack traces resolve to real .ts line numbers.
src/**
**/*.ts

# All dependencies are devDependencies, so nothing is needed at runtime
node_modules/**

# Build and repo config
tsconfig.json
package-lock.json
.gitignore
.gitattributes

# Don't nest a package inside a package
*.vsix
